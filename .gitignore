# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
coverage/
.vitest/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Large local assets.
# Originals stay in TAI_PHAN_MEM/; public/ copies are generated by
# `npm run setup:assets` (also runs automatically before `npm run build`).
TAI_PHAN_MEM/archives/*
!TAI_PHAN_MEM/archives/.gitkeep
TAI_PHAN_MEM/models/*.task
TAI_PHAN_MEM/models/*.tflite
TAI_PHAN_MEM/models/*.onnx
TAI_PHAN_MEM/mediapipe/
public/models/*.task
public/models/*.tflite
public/models/*.onnx
public/mediapipe/wasm/
