# ============================================================
# Teacher Coach AI — biến môi trường
# Sao chép tệp này thành .env.local nếu muốn đặt khóa Gemini ở server.
# KHÔNG đặt khóa bí mật trong biến có tiền tố VITE_.
# ============================================================

# Khóa Gemini API phía server (khuyến nghị cho triển khai thật).
# Lấy tại: https://aistudio.google.com/apikey
# Có thể để trống: người dùng vẫn nhập được khóa tạm trong
# Cài đặt → AI (chỉ lưu sessionStorage của tab hiện tại).
# Nếu cả hai cùng có, khóa nhập trong tab được ưu tiên cho yêu cầu đó.
GEMINI_API_KEY=

# Model Gemini mặc định phía server. Client có thể chọn model khác
# (Gemini 2.5 Flash / Flash Lite / Pro) trong Cài đặt → AI.
GEMINI_MODEL=gemini-2.5-flash

# Cổng của proxy AI độc lập khi chạy `npm run dev:ai` (mặc định 8787).
# Không cần dùng khi chạy `npm run dev` vì Vite đã tích hợp /api/ai.
AI_DEV_PORT=8787

# Đích mà Vite proxy /api tới khi phát triển.
# Chỉ cần đổi nếu proxy AI chạy ở cổng/máy khác.
VITE_AI_DEV_ORIGIN=http://localhost:8787
