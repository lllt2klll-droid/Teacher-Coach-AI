{
  "name": "teacher-coach-ai",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Nền tảng AI hỗ trợ sinh viên Sư phạm Tiểu học luyện tập giảng dạy",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/setup-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:assets": "node scripts/setup-assets.mjs",
    "dev:ai": "node server/dev-ai-server.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^30.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "motion": "^14.12.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
